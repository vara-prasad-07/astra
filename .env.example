# NIGHTWATCH configuration
#
# Copy to .env and fill in what you have — or just run:  python setup.py
# Any value left blank keeps that integration on deterministic demo fixtures,
# and the full incident workflow still runs end to end.

# --- PagerDuty: incident trigger (entry point)
# https://developer.pagerduty.com -> My Profile -> User Settings -> API User Token
PAGERDUTY_API_KEY=
PAGERDUTY_FROM_EMAIL=23211a04d9@bvrit.ac.in
PAGERDUTY_WEBHOOK_SECRET=

# --- Datadog: logs and metrics
# Organization Settings -> API Keys / Application Keys (needs logs_read_data)
DD_API_KEY=
DD_APP_KEY=
# Must match the region your Datadog org actually lives on — trial signups can
# land on any of these. If validate 403s, try the others:
# datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com
DD_SITE=datadoghq.com

# --- GitHub: PRs, commits, changed files
# Settings -> Developer settings -> Fine-grained tokens
# Repository permissions: Contents=Read, Pull requests=Read, Deployments=Read
GITHUB_TOKEN=
GITHUB_REPO=

# --- Slack: the human approval surface
# api.slack.com/apps -> Bot Token Scopes: chat:write, channels:read, users:read
# Interactivity Request URL: https://<ngrok>/webhooks/slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=

# --- LLM: narrative summaries only; hypothesis scoring is deterministic
GROQ_API_KEY=
# If setup.py --verify 404s on the model, it prints what your key can actually
# see — pick one from that list.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
LLM_PROVIDER=auto

# --- Render: real deploy history + real rollback (redeploy the previous
# build, not an in-app flag flip). Leaving this blank keeps rollback scoped
# to whatever DEMO_SERVICE_URL exposes (its own /admin/rollback, or fixtures).
# Render Dashboard -> Account Settings -> API Keys
RENDER_API_KEY=
# From the service's Render dashboard URL: dashboard.render.com/web/<srv-...>
RENDER_SERVICE_ID=

# --- NIGHTWATCH runtime
# Comma-separated identities allowed to approve a rollback. Blank = anyone.
NIGHTWATCH_APPROVERS=
NIGHTWATCH_MODE=auto
NIGHTWATCH_HOST=127.0.0.1
NIGHTWATCH_PORT=8000
DEMO_SERVICE_URL=http://127.0.0.1:8100
